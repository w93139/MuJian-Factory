# 开源仓库只保存本模板；复制为 .env 后填写，绝不提交实际值。
MUJIAN_PUBLIC_MODE=1
MUJIAN_ADMIN_PASSWORD=
MUJIAN_SESSION_SECRET=
MUJIAN_COOKIE_SECURE=0

# 每日估算调用费用上限（人民币）；空值为不限。公开演示建议保留上限。
MUJIAN_DAILY_BUDGET_CNY=50
# 同时执行的六阶段或快捷流水线任务上限；空值为不限。
MUJIAN_MAX_CONCURRENT_JOBS=1

# 主流程默认模型需要百炼与方舟密钥。按实际开通平台填写。
DASHSCOPE_API_KEY=
ARK_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# 可选，逗号分隔的额外跨域来源。生产同源部署通常保持空值。
MUJIAN_CORS_ORIGINS=
